# ===========================================
# AeroFly Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# --- PostgreSQL ---
POSTGRES_USER=aerofly
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aerofly
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Meilisearch ---
MEILI_MASTER_KEY=changeme_meili_key
MEILI_HOST=meilisearch
MEILI_PORT=7700

# --- Gateway ---
GATEWAY_PORT=8000
JWT_SECRET=changeme_jwt_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Data Ingestion ---
DATA_INGESTION_PORT=8001
DFS_BASE_URL=https://aip.dfs.de

# --- Search ---
SEARCH_PORT=8002

# --- Frontend ---
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000/api
